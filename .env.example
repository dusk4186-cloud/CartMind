# Google Gemini API Authentication
GOOGLE_API_KEY=your_actual_gemini_api_key

# Configurable Gemini Model (e.g. gemini-3.5-flash-lite, gemini-3-flash-preview, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Authentication (Ultra-fast LPU inference)
GROQ_API_KEY=your_actual_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Existing FastAPI backend service URL
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Agent orchestration settings
AGENT_MAX_ITERATIONS=8
API_TIMEOUT_SECONDS=15

# LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_actual_langsmith_api_key
LANGCHAIN_PROJECT=ecommerce-cx-intelligence
